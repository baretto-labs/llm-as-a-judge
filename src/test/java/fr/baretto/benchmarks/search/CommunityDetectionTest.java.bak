package fr.baretto.benchmarks.search;

import dev.langchain4j.model.chat.ChatLanguageModel;
import dev.langchain4j.model.ollama.OllamaChatModel;
import org.junit.jupiter.api.*;
import org.neo4j.driver.*;
import org.testcontainers.containers.Neo4jContainer;
import org.testcontainers.junit.jupiter.Container;
import org.testcontainers.junit.jupiter.Testcontainers;

import java.util.List;
import java.util.Map;

import static org.junit.jupiter.api.Assertions.*;

/**
 * Tests pour CommunityDetection (détection de clusters, résumés LLM).
 * Crée un graphe avec 2 communautés distinctes pour validation.
 */
@Testcontainers
@TestMethodOrder(MethodOrderer.OrderAnnotation.class)
class CommunityDetectionTest {

    @Container
    private static final Neo4jContainer<?> neo4jContainer = new Neo4jContainer<>("neo4j:5.15")
        .withAdminPassword("test1234");

    private static Driver driver;
    private static CommunityDetection communityDetection;
    private static CommunityDetection communityDetectionWithLLM;

    @BeforeAll
    static void setup() {
        driver = GraphDatabase.driver(
            neo4jContainer.getBoltUrl(),
            AuthTokens.basic("neo4j", "test1234")
        );

        // Version sans LLM (pour tests rapides)
        communityDetection = new CommunityDetection(driver);

        // Version avec LLM (optionnel, nécessite Ollama)
        try {
            ChatLanguageModel llm = OllamaChatModel.builder()
                .baseUrl("http://localhost:11434")
                .modelName("llama3.2:1b") // Modèle léger pour tests
                .temperature(0.3)
                .build();
            communityDetectionWithLLM = new CommunityDetection(driver, llm);
            System.out.println("✅ LLM Ollama disponible pour tests de résumés");
        } catch (Exception e) {
            communityDetectionWithLLM = communityDetection; // Fallback sans LLM
            System.out.println("⚠️  LLM Ollama non disponible, tests résumés skippés");
        }

        // Créer un graphe avec 2 communautés distinctes
        createTestGraphWithCommunities();
    }

    @AfterAll
    static void tearDown() {
        if (driver != null) {
            driver.close();
        }
    }

    /**
     * Crée un graphe avec 2 communautés distinctes:
     * - Communauté 1: Module Authentication (AuthService, UserRepository, Token)
     * - Communauté 2: Module Payment (PaymentGateway, TransactionLog)
     */
    private static void createTestGraphWithCommunities() {
        try (Session session = driver.session()) {

            // === COMMUNAUTÉ 1: AUTHENTICATION ===

            // AuthenticationService
            session.run("""
                CREATE (c:Class {
                    name: 'AuthenticationService',
                    fqn: 'com.example.auth.AuthenticationService',
                    javaDoc: 'Handles user authentication with JWT tokens'
                })
                """);

            // UserRepository
            session.run("""
                CREATE (c:Class {
                    name: 'UserRepository',
                    fqn: 'com.example.auth.UserRepository',
                    javaDoc: 'Repository for user data persistence'
                })
                """);

            // TokenManager
            session.run("""
                CREATE (c:Class {
                    name: 'TokenManager',
                    fqn: 'com.example.auth.TokenManager',
                    javaDoc: 'Manages JWT token generation and validation'
                })
                """);

            // Méthodes auth module
            session.run("""
                CREATE (m:Method {
                    name: 'authenticate',
                    fqn: 'com.example.auth.AuthenticationService.authenticate'
                })
                """);

            session.run("""
                CREATE (m:Method {
                    name: 'findByUsername',
                    fqn: 'com.example.auth.UserRepository.findByUsername'
                })
                """);

            session.run("""
                CREATE (m:Method {
                    name: 'generateToken',
                    fqn: 'com.example.auth.TokenManager.generateToken'
                })
                """);

            // Relations intra-communauté auth
            session.run("""
                MATCH (auth:Class {name: 'AuthenticationService'}),
                      (authMethod:Method {name: 'authenticate'})
                CREATE (auth)-[:DECLARES]->(authMethod)
                """);

            session.run("""
                MATCH (repo:Class {name: 'UserRepository'}),
                      (findMethod:Method {name: 'findByUsername'})
                CREATE (repo)-[:DECLARES]->(findMethod)
                """);

            session.run("""
                MATCH (token:Class {name: 'TokenManager'}),
                      (genMethod:Method {name: 'generateToken'})
                CREATE (token)-[:DECLARES]->(genMethod)
                """);

            session.run("""
                MATCH (authMethod:Method {name: 'authenticate'}),
                      (findMethod:Method {name: 'findByUsername'})
                CREATE (authMethod)-[:CALLS]->(findMethod)
                """);

            session.run("""
                MATCH (authMethod:Method {name: 'authenticate'}),
                      (genMethod:Method {name: 'generateToken'})
                CREATE (authMethod)-[:CALLS]->(genMethod)
                """);

            // === COMMUNAUTÉ 2: PAYMENT ===

            // PaymentGateway
            session.run("""
                CREATE (c:Class {
                    name: 'PaymentGateway',
                    fqn: 'com.example.payment.PaymentGateway',
                    javaDoc: 'Handles payment processing with Stripe API'
                })
                """);

            // TransactionLog
            session.run("""
                CREATE (c:Class {
                    name: 'TransactionLog',
                    fqn: 'com.example.payment.TransactionLog',
                    javaDoc: 'Logs all payment transactions'
                })
                """);

            // Méthodes payment module
            session.run("""
                CREATE (m:Method {
                    name: 'processPayment',
                    fqn: 'com.example.payment.PaymentGateway.processPayment'
                })
                """);

            session.run("""
                CREATE (m:Method {
                    name: 'logTransaction',
                    fqn: 'com.example.payment.TransactionLog.logTransaction'
                })
                """);

            // Relations intra-communauté payment
            session.run("""
                MATCH (gateway:Class {name: 'PaymentGateway'}),
                      (processMethod:Method {name: 'processPayment'})
                CREATE (gateway)-[:DECLARES]->(processMethod)
                """);

            session.run("""
                MATCH (log:Class {name: 'TransactionLog'}),
                      (logMethod:Method {name: 'logTransaction'})
                CREATE (log)-[:DECLARES]->(logMethod)
                """);

            session.run("""
                MATCH (processMethod:Method {name: 'processPayment'}),
                      (logMethod:Method {name: 'logTransaction'})
                CREATE (processMethod)-[:CALLS]->(logMethod)
                """);

            System.out.println("✅ Graphe de test créé avec 2 communautés:");
            System.out.println("   Communauté 1: Authentication (3 classes, 3 méthodes)");
            System.out.println("   Communauté 2: Payment (2 classes, 2 méthodes)");
        }
    }

    @Test
    @Order(1)
    @DisplayName("Test 1: Détection de communautés basique")
    void test1_BasicCommunityDetection() throws SearchException {
        List<CommunityDetection.Community> communities = communityDetection.detectCommunities(
            2, // Min size
            10 // Max iterations
        );

        assertFalse(communities.isEmpty(), "Devrait détecter au moins 1 communauté");
        System.out.println("Communautés détectées: " + communities.size());

        for (CommunityDetection.Community community : communities) {
            System.out.println("  - " + community);
            assertTrue(community.size() >= 2, "Communauté devrait avoir au moins 2 nœuds");
        }
    }

    @Test
    @Order(2)
    @DisplayName("Test 2: Communautés de taille minimale respectée")
    void test2_MinCommunitySizeRespected() throws SearchException {
        int minSize = 3;
        List<CommunityDetection.Community> communities = communityDetection.detectCommunities(
            minSize,
            10
        );

        for (CommunityDetection.Community community : communities) {
            assertTrue(community.size() >= minSize,
                "Communauté " + community.name() + " devrait avoir au moins " + minSize + " nœuds");
        }
    }

    @Test
    @Order(3)
    @DisplayName("Test 3: Vérifier qu'on a 2 communautés distinctes")
    void test3_TwoDistinctCommunities() throws SearchException {
        List<CommunityDetection.Community> communities = communityDetection.detectCommunities(
            2,
            15 // Plus d'itérations pour convergence
        );

        // On devrait avoir 2 communautés (auth + payment)
        assertTrue(communities.size() >= 1, "Devrait avoir au moins 1 communauté");
        System.out.println("Nombre de communautés détectées: " + communities.size());

        // Vérifier que les communautés sont bien distinctes (pas de nœuds en commun)
        if (communities.size() >= 2) {
            CommunityDetection.Community comm1 = communities.get(0);
            CommunityDetection.Community comm2 = communities.get(1);

            List<Long> nodeIds1 = comm1.nodes().stream()
                .map(CommunityDetection.CommunityNode::nodeId)
                .toList();

            List<Long> nodeIds2 = comm2.nodes().stream()
                .map(CommunityDetection.CommunityNode::nodeId)
                .toList();

            // Aucun nœud en commun
            boolean hasOverlap = nodeIds1.stream().anyMatch(nodeIds2::contains);
            assertFalse(hasOverlap, "Les communautés ne devraient pas partager de nœuds");
        }
    }

    @Test
    @Order(4)
    @DisplayName("Test 4: Obtenir classes et méthodes d'une communauté")
    void test4_GetClassesAndMethods() throws SearchException {
        List<CommunityDetection.Community> communities = communityDetection.detectCommunities(
            2,
            10
        );

        assertFalse(communities.isEmpty(), "Devrait avoir au moins 1 communauté");

        CommunityDetection.Community community = communities.get(0);

        List<CommunityDetection.CommunityNode> classes = community.getClasses();
        List<CommunityDetection.CommunityNode> methods = community.getMethods();

        assertFalse(classes.isEmpty(), "La communauté devrait avoir au moins 1 classe");
        System.out.println("Communauté " + community.name() + ":");
        System.out.println("  Classes: " + classes.stream().map(CommunityDetection.CommunityNode::name).toList());
        System.out.println("  Méthodes: " + methods.stream().map(CommunityDetection.CommunityNode::name).toList());
    }

    @Test
    @Order(5)
    @DisplayName("Test 5: Génération de résumé LLM (si disponible)")
    void test5_LLMSummaryGeneration() throws SearchException {
        List<CommunityDetection.Community> communities = communityDetectionWithLLM.detectCommunities(
            2,
            10
        );

        assertFalse(communities.isEmpty(), "Devrait avoir au moins 1 communauté");

        for (CommunityDetection.Community community : communities) {
            assertNotNull(community.summary(), "Le résumé ne devrait pas être null");
            assertFalse(community.summary().isEmpty(), "Le résumé ne devrait pas être vide");

            System.out.println("Communauté: " + community.name());
            System.out.println("Résumé: " + community.summary());
            System.out.println();
        }
    }

    @Test
    @Order(6)
    @DisplayName("Test 6: Recherche dans communautés par nom de classe")
    void test6_SearchCommunitiesByClassName() throws SearchException {
        List<CommunityDetection.Community> allCommunities = communityDetection.detectCommunities(
            2,
            10
        );

        // Chercher communauté contenant "Authentication"
        List<CommunityDetection.Community> results = communityDetection.searchCommunities(
            allCommunities,
            "Authentication",
            3
        );

        assertFalse(results.isEmpty(), "Devrait trouver au moins 1 communauté avec 'Authentication'");

        // Vérifier que la communauté contient bien AuthenticationService
        CommunityDetection.Community authCommunity = results.get(0);
        boolean hasAuthService = authCommunity.getClasses().stream()
            .anyMatch(node -> node.name().contains("Authentication"));

        assertTrue(hasAuthService, "La communauté devrait contenir AuthenticationService");
        System.out.println("Trouvé communauté: " + authCommunity.name() + " (size=" + authCommunity.size() + ")");
    }

    @Test
    @Order(7)
    @DisplayName("Test 7: Recherche dans communautés par nom de méthode")
    void test7_SearchCommunitiesByMethodName() throws SearchException {
        List<CommunityDetection.Community> allCommunities = communityDetection.detectCommunities(
            2,
            10
        );

        // Chercher communauté contenant "payment"
        List<CommunityDetection.Community> results = communityDetection.searchCommunities(
            allCommunities,
            "payment",
            3
        );

        if (!results.isEmpty()) {
            CommunityDetection.Community paymentCommunity = results.get(0);
            System.out.println("Trouvé communauté payment: " + paymentCommunity.name());

            boolean hasPaymentClass = paymentCommunity.getClasses().stream()
                .anyMatch(node -> node.name().toLowerCase().contains("payment"));

            assertTrue(hasPaymentClass, "La communauté devrait contenir une classe Payment");
        }
    }

    @Test
    @Order(8)
    @DisplayName("Test 8: Recherche sans résultats retourne liste vide")
    void test8_SearchNoResults() throws SearchException {
        List<CommunityDetection.Community> allCommunities = communityDetection.detectCommunities(
            2,
            10
        );

        List<CommunityDetection.Community> results = communityDetection.searchCommunities(
            allCommunities,
            "NonExistentModuleXYZ123",
            3
        );

        assertTrue(results.isEmpty(), "Ne devrait trouver aucune communauté");
    }

    @Test
    @Order(9)
    @DisplayName("Test 9: Validation paramètres invalides")
    void test9_ValidationInvalidParams() {
        assertThrows(IllegalArgumentException.class, () ->
            communityDetection.detectCommunities(0, 10),
            "minSize=0 devrait lancer exception");

        assertThrows(IllegalArgumentException.class, () ->
            communityDetection.detectCommunities(3, 0),
            "maxIterations=0 devrait lancer exception");

        assertThrows(IllegalArgumentException.class, () ->
            communityDetection.detectCommunities(3, 100),
            "maxIterations=100 devrait lancer exception");
    }

    @Test
    @Order(10)
    @DisplayName("Test 10: Convergence avec plus d'itérations")
    void test10_ConvergenceWithMoreIterations() throws SearchException {
        // Peu d'itérations
        List<CommunityDetection.Community> communities5 = communityDetection.detectCommunities(
            2,
            5
        );

        // Plus d'itérations
        List<CommunityDetection.Community> communities20 = communityDetection.detectCommunities(
            2,
            20
        );

        // Les résultats devraient être similaires (convergence)
        assertFalse(communities5.isEmpty(), "Devrait avoir communautés avec 5 itérations");
        assertFalse(communities20.isEmpty(), "Devrait avoir communautés avec 20 itérations");

        System.out.println("Communautés (5 iter): " + communities5.size());
        System.out.println("Communautés (20 iter): " + communities20.size());
    }
}
